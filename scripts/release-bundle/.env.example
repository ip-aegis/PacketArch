# PacketArch .env template.
# install.sh auto-generates a filled-in .env on fresh install. Use this
# template when hand-provisioning or when you need to know the full set
# of supported variables.

# ── Required: database + auth secrets ──────────────────────────────────
# Each should be a freshly-generated random string. DO NOT reuse across
# deployments. Tooling: `openssl rand -hex 32`
POSTGRES_PASSWORD=
SECRET_KEY=
ENCRYPTION_KEY=

# ── Optional: legacy admin bootstrap ───────────────────────────────────
# New installs leave this blank. The first-run setup wizard at
# https://<server>/ creates the admin account. Set this only if you want
# the backend to auto-create an admin on first boot from this var
# (legacy path; mostly useful for automated test harnesses).
ADMIN_PASSWORD=

# ── Feature flags ──────────────────────────────────────────────────────
# AI_ENABLED=false hides the AI wizard, assistant, and command-palette
# entries, and causes /api/v1/ai/* to return 503. Set to true if you
# intend to provide an Anthropic API key via Settings → AI Provider.
AI_ENABLED=false

# LIVE_TRAFFIC_ENABLED=false ships PacketArch as a PCAP-only generator:
# remote-agent WebSocket hub, agent install bundle, deployment dashboard,
# and live attack/adaptation runtime control are gated off. Scenario
# authoring, AI, fingerprints, attack simulation IN PCAP, adaptive
# traffic IN PCAP, process simulation, and Cyber Vision device import
# all remain available. install.sh sets this automatically when the
# PCAP-only release variant is installed.
LIVE_TRAFFIC_ENABLED=true

# ── Build metadata (shown in /about + About modal) ─────────────────────
BUILD_COMMIT=
BUILD_DATE=

# ── Misc ───────────────────────────────────────────────────────────────
DEBUG=false
