# PacketArch Docker Environment Configuration
# Copy this file to .env and update values before running docker-compose

# =============================================================================
# Database
# =============================================================================
POSTGRES_PASSWORD=secure_password_here

# =============================================================================
# Backend Security
# =============================================================================
# Generate with: openssl rand -hex 32
SECRET_KEY=your_secret_key_here

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty to auto-generate (not recommended for production)
ENCRYPTION_KEY=

# =============================================================================
# Admin User
# =============================================================================
ADMIN_PASSWORD=your_admin_password

# =============================================================================
# Debug Mode (set to true for development)
# =============================================================================
DEBUG=false

# =============================================================================
# Docker socket access
# =============================================================================
# The backend container needs to match the HOST's docker group GID to use the
# mounted Docker socket (for spawning traffic-generator containers). Find it
# with: getent group docker | cut -d: -f3
# Common values: 999 (clean Ubuntu), 987 (this dev host). Defaults to 987.
DOCKER_GID=999

# =============================================================================
# Optional: AI Features (Anthropic Claude)
# =============================================================================
# ANTHROPIC_API_KEY=your_api_key_here

# ----- Cisco CIRCUIT AI provider (optional) -----
# Overrides the encrypted system_settings rows when set. Used by the
# backend + celery worker containers. Leave blank to manage via the
# admin Settings UI instead.
CIRCUIT_CLIENT_ID=
CIRCUIT_CLIENT_SECRET=
CIRCUIT_APP_KEY=
CIRCUIT_MODEL=gpt-4.1
