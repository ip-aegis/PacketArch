# PacketArch Docker Environment Configuration
# Copy this file to .env and update values before running docker-compose

# =============================================================================
# Database
# =============================================================================
POSTGRES_PASSWORD=secure_password_here

# =============================================================================
# Backend Security
# =============================================================================
# Generate with: openssl rand -hex 32
SECRET_KEY=your_secret_key_here

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty to auto-generate (not recommended for production)
ENCRYPTION_KEY=

# =============================================================================
# Admin User (OPTIONAL — leave unset for the setup wizard)
# =============================================================================
# UNSET (default): first boot serves the setup wizard at https://<server>/
#   where you create the admin and name the site. Recommended.
# SET: auto-creates an "admin" user with this password and SKIPS the wizard.
#   Use only for headless/automated installs.
# ADMIN_PASSWORD=your_admin_password

# =============================================================================
# Debug Mode (set to true for development)
# =============================================================================
DEBUG=false

# =============================================================================
# Docker socket access
# =============================================================================
# The backend container must match the HOST's docker group GID to use the
# mounted Docker socket (for spawning traffic-generator containers). The GID
# VARIES by distro/install (e.g. 988 on Ubuntu 24.04, 987 on some Fedora) —
# don't guess, derive it on the box:  getent group docker | cut -d: -f3
# Falls back to 987 if unset.
DOCKER_GID=988

# =============================================================================
# Self-upgrade (one-button UI upgrade — git-clone installs)
# =============================================================================
# Absolute path of THIS install on the host. The backend launches the updater
# container against this directory (it only sees /app otherwise). Set it to
# wherever you cloned PacketArch.
HOST_INSTALL_DIR=/home/youruser/packetarch
# Pinned compose project name so the updater's inner `docker compose` manages
# the same project as the running stack (don't change after first start).
COMPOSE_PROJECT_NAME=packetarch

# =============================================================================
# Container networking
# =============================================================================
# Subnet for the stack's own bridge network. PINNED (rather than taken from
# Docker's default pools) because a VPN/site route that overlaps those pools
# makes the stack come up and still be unreachable from the host, and can break
# Docker's embedded DNS so `backend` stops resolving for nginx. Change this only
# if your site actually routes 10.200.0.0/24 — then:
#   docker compose down && docker compose up -d      (a subnet change needs the
#                                                     network recreated)
# scripts/check-docker-egress.sh flags a collision with this value.
COMPOSE_SUBNET=10.200.0.0/24

# Build-time network for image builds. Leave unset on a healthy host. Set to
# `host` ONLY when this host's bridged build sandbox has no egress and you
# cannot fix /etc/docker/daemon.json — see ./scripts/check-docker-egress.sh.
# DOCKER_BUILD_NETWORK=host

# =============================================================================
# Optional: AI Features (Anthropic Claude)
# =============================================================================
# ANTHROPIC_API_KEY=your_api_key_here

# ----- Cisco CIRCUIT AI provider (optional) -----
# Overrides the encrypted system_settings rows when set. Used by the
# backend + celery worker containers. Leave blank to manage via the
# admin Settings UI instead.
CIRCUIT_CLIENT_ID=
CIRCUIT_CLIENT_SECRET=
CIRCUIT_APP_KEY=
CIRCUIT_MODEL=gpt-5-nano
