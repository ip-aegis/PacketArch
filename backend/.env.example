# PacketArch Backend Environment Configuration
# Copy this file to .env and update the values

# Application
APP_NAME=PacketArch
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# API Server
API_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8001

# CORS Origins (comma-separated)
# Add your frontend URL for off-box access (e.g., http://192.168.1.100:3001)
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# Database (PostgreSQL + TimescaleDB)
DATABASE_URL=postgresql+asyncpg://packetarch:packetarch_dev@localhost:5432/packetarch

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
# IMPORTANT: Change this in production! Use: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption Key (for storing API keys)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If not set, will be derived from SECRET_KEY
ENCRYPTION_KEY=

# PCAP Output
PCAP_OUTPUT_DIR=./output/pcap
MAX_SIMULATION_DURATION_MS=600000

# First User (created on startup if no users exist)
FIRST_USER_USERNAME=admin
FIRST_USER_PASSWORD=changeme123
